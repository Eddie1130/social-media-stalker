# Private runtime settings; copy to .env.tiktok (chmod 600).
OPENVPN_USER=
OPENVPN_PASSWORD=
SERVER_COUNTRIES=Japan
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Shared I/O backpressure; 1 reduces historical work while storage is busy.
ARCHIVE_PRESSURE_ENABLED=1
# Finite whole browser-query deadline; navigation keeps its own bound.
TIKTOK_CATALOG_QUERY_TIMEOUT_SECONDS=180

# Public post queries use a separate anonymous browser context; 0 restores authenticated queries.
TIKTOK_CATALOG_ANONYMOUS_POSTS=1
# 貼文清單輪詢測試，預設每帳號至少相隔一小時。設 0 可恢復原排程。
TIKTOK_CATALOG_POST_POLL_TEST_SECONDS=0
# 全帳號排程貼文請求的最短間隔，0 表示沿用原排程。
TIKTOK_CATALOG_POST_REQUEST_GAP_SECONDS=0
